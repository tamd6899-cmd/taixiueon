<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEON TÀI XỈU</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">

<header>
    <div class="logo">🎲 NEON TÀI XỈU</div>
    <div class="demo">● CHẾ ĐỘ DEMO</div>
</header>

<section class="account">
    <div>
        <small>SỐ DƯ HIỆN TẠI</small>
        <h2>1.000.000 <span>xu</span></h2>
    </div>
</section>

<section class="game">

    <div class="round">
        PHIÊN #000128
    </div>

    <div class="dice-area">
        <div class="dice">
            <div class="die">⚄</div>
            <div class="die">⚂</div>
            <div class="die">⚅</div>
        </div>
        <p>KẾT QUẢ SẼ HIỂN THỊ TẠI ĐÂY</p>
    </div>

    <div class="result">
        <div>
            <small>TỔNG ĐIỂM</small>
            <h2>---</h2>
        </div>
        <div>
            <small>KẾT QUẢ</small>
            <h2>CHỜ PHIÊN</h2>
        </div>
    </div>

</section>

<section class="bet">

    <h2>CHỌN CỬA CƯỢC</h2>

    <div class="buttons">
        <button class="tai">
            ▲ TÀI
            <small>11 - 17 điểm</small>
        </button>

        <button class="xiu">
            ▼ XỈU
            <small>4 - 10 điểm</small>
        </button>
    </div>

    <div class="stake">
        <h3>MỨC CƯỢC</h3>
        <div class="amount">100.000 xu ảo</div>

        <div class="chips">
            <button>10K</button>
            <button>50K</button>
            <button>100K</button>
            <button>500K</button>
        </div>

        <button class="confirm" disabled>
            CHỌN CỬA ĐỂ TIẾP TỤC
        </button>
    </div>

</section>

<section class="history">
    <h2>LỊCH SỬ PHIÊN</h2>
    <p>Chưa có kết quả</p>
</section>

<footer>
    NEON TÀI XỈU © 2026
    <p>GAME MÔ PHỎNG - SỬ DỤNG XU ẢO</p>
</footer>

</div>

<script src="game.js"></script>
</body>
</html>
